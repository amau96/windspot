project.manifest = manifest.xml

# Reglages par defaut (spot...) : Mazerolles sur toutes les montres.
# settings/phone : reglages telephone avec la liste des 301 spots.
# settings/basic : sans la liste, pour les montres limitees a 254 textes (API 3.x) ; elles ont le menu sur la montre.
